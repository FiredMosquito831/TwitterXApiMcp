# OAuth 2.0 app credentials (https://console.x.com)
X_CLIENT_ID=
# Optional for confidential clients:
# X_CLIENT_SECRET=
# Must match the redirect URI registered on the app:
# X_REDIRECT_URI=http://localhost:8080/callback

# Alternative to the credential store:
# X_USER_TOKEN=
# X_BEARER_TOKEN=

X_PROFILE=default
XCTL_SPEND_CAP=5
